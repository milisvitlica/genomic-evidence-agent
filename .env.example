# Sibling checkout that holds the processed classifier tables.
# Default, if unset: ../clinvar-pathogenicity-classifier
CLASSIFIER_ROOT=/absolute/path/to/clinvar-pathogenicity-classifier

# LangChain model string passed to create_agent (provider:name).
MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=

# In-process PubMed MCP tool (NCBI E-utilities). Set to false to run with the
# two classifier dataset tools only.
PUBMED_MCP_ENABLED=true

# Optional. NCBI raises the request rate when a key and contact email are set.
NCBI_API_KEY=
NCBI_EMAIL=
