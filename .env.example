# Parquet files read by the two dataset tools.
# Unset uses ../clinvar-pathogenicity-classifier/data/processed/<file>
# JOINED_DATASET=/absolute/path/to/clinvar_uniprot_joined.parquet
# SCORED_VUS=/absolute/path/to/vus_inference_predictions.parquet

# LangChain model string passed to create_agent (provider:name).
MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=

# In-process PubMed MCP tool (NCBI E-utilities). Set to false to run with the
# two classifier dataset tools only.
PUBMED_MCP_ENABLED=true

# Optional. NCBI raises the request rate when a key and contact email are set.
NCBI_API_KEY=
NCBI_EMAIL=
